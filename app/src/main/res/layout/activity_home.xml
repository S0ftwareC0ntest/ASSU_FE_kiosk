<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_main"
    android:background="@color/assu_tablet_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity">
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_navigator"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="@color/assu_sidebar_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.175">
        <View
            android:id="@+id/view_navigator_mg1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.1913" />
        <View
            android:id="@+id/view_navigator_mg2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@+id/view_navigator_mg1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.7129"
            app:layout_constraintHeight_percent="0.0839"/>
        <View
            android:id="@+id/view_navigator_mg3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/view_navigator_mg1"
            app:layout_constraintTop_toBottomOf="@id/view_navigator_mg2"
            app:layout_constraintWidth_percent="0.1196"/>

        <ImageView
            android:id="@+id/iv_title"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_tablet_logo"
            app:layout_constraintStart_toEndOf="@+id/view_navigator_mg3"
            app:layout_constraintTop_toBottomOf="@+id/view_navigator_mg2"
            app:layout_constraintWidth_percent="0.4736"
            app:layout_constraintHeight_percent="0.0323"/>
        <View
            android:id="@+id/view_navigator_mg4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@+id/view_navigator_mg1"
            app:layout_constraintTop_toBottomOf="@+id/iv_title"
            app:layout_constraintWidth_percent="0.7129"
            app:layout_constraintHeight_percent="0.0659"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_navigator_menu_select"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/view_navigator_mg1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/view_navigator_mg4"
            app:layout_constraintWidth_percent="0.7129"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_menu_types">

        </androidx.recyclerview.widget.RecyclerView>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_menus"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@id/layout_navigator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5737"> <!--width : 685dp-->
        <View
            android:id="@+id/view_menus_mg1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.0291"/>
        <View
            android:id="@+id/view_menus_mg2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHeight_percent="0.0551"/>
        <View
            android:id="@+id/view_menus_mg3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/view_menus_mg1"
            app:layout_constraintTop_toBottomOf="@id/view_menus_mg2"
            app:layout_constraintWidth_percent="0.0291"/>

        <LinearLayout
            android:id="@+id/layout_menus_recommend"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/view_menus_mg3"
            app:layout_constraintTop_toBottomOf="@id/view_menus_mg2"
            app:layout_constraintWidth_percent="0.5051"
            app:layout_constraintHeight_percent="0.0287"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/iv_menus_thumbs_up"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="2.5dp"
                android:src="@drawable/ic_thumbs_up"/>
            <View
                android:id="@+id/view_menus_recommend_mg1"
                android:layout_width="19dp"
                android:layout_height="0dp"/>
            <TextView
                android:id="@+id/tv_menus_recommend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="제휴리뷰 쓰고 기프티콘까지 받고 싶다면 ASSU"
                android:textSize="17sp"
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/white"/>
        </LinearLayout>
        <View
            android:id="@+id/view_menus_mg4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_menus_recommend"
            app:layout_constraintHeight_percent="0.0413"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_menus_menu_list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/view_menus_mg1"
            app:layout_constraintTop_toBottomOf="@id/view_menus_mg4"
            app:layout_constraintWidth_percent="0.9416"
            app:layout_constraintHeight_percent="0.8764"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            android:scrollbars="none"
            tools:listitem="@layout/item_menus">

        </androidx.recyclerview.widget.RecyclerView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_side_bar"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.2512"
        android:background="@color/assu_sidebar_background">

        <View
            android:id="@+id/view_side_bar_mg1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.0666"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_side_bar_top"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@+id/view_side_bar_mg1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.9333"
            app:layout_constraintHeight_percent="0.0983">

            <TextView
                android:id="@+id/tv_side_bar_bucket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="장바구니"
                android:textSize="25sp"
                android:fontFamily="@font/pretendard_semibold"
                android:textColor="@color/white"
                android:includeFontPadding="false" />

            <LinearLayout
                android:id="@+id/layout_side_bar_table"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.3821"
                android:background="@color/table_number_background"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_side_bar_table"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="테이블"
                    android:textSize="25sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/pretendard_semibold"
                    android:includeFontPadding="false"/>

                <TextView
                    android:id="@+id/tv_side_bar_table_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15"
                    android:textSize="30sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/pretendard_semibold"
                    android:includeFontPadding="false"/>

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/view_side_bar_mg2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/view_side_bar_mg1"
            app:layout_constraintTop_toBottomOf="@id/layout_side_bar_top"
            app:layout_constraintHeight_percent="0.0563"/>

        <TextView
            android:id="@+id/tv_side_bar_select_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/view_side_bar_mg1"
            app:layout_constraintTop_toBottomOf="@id/view_side_bar_mg2"
            android:text="메뉴를 선택해주세요"
            android:textSize="17sp"
            android:textColor="@color/white"
            android:fontFamily="@font/pretendard_regular"/>

        <View
            android:id="@+id/view_side_bar_mg3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/view_side_bar_mg1"
            app:layout_constraintTop_toBottomOf="@id/tv_side_bar_select_menu"
            app:layout_constraintHeight_percent="0.0239"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_side_bar_selected_menu_list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/view_side_bar_mg1"
            app:layout_constraintTop_toBottomOf="@id/view_side_bar_mg3"
            app:layout_constraintWidth_percent="0.7933"
            app:layout_constraintHeight_percent="0.4916"
            tools:listitem="@layout/item_bucket">


        </androidx.recyclerview.widget.RecyclerView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_side_bar_total_price"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/view_side_bar_mg1"
            app:layout_constraintTop_toBottomOf="@id/rv_side_bar_selected_menu_list"
            app:layout_constraintWidth_percent="0.7933"
            app:layout_constraintHeight_percent="0.0383">

            <View
                android:id="@+id/view_side_bar_total_price_border"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@color/white"/>

            <TextView
                android:id="@+id/tv_side_bar_total_price_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="합계"
                android:textSize="17sp"
                android:textColor="@color/white"
                android:fontFamily="@font/pretendard_regular"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/tv_side_bar_total_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="0"
                android:textSize="24sp"
                android:textColor="@color/white"
                android:fontFamily="@font/pretendard_bold"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/tv_side_bar_total_price_won"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@id/tv_side_bar_total_price"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="₩"
                android:textSize="24sp"
                android:textColor="@color/white"
                android:fontFamily="@font/pretendard_bold"
                android:includeFontPadding="false"
                android:layout_marginRight="7dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/view_side_bar_mg4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/view_side_bar_mg1"
            app:layout_constraintTop_toBottomOf="@id/layout_side_bar_total_price"
            app:layout_constraintHeight_percent="0.0503"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_side_bar_view_order_list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/view_side_bar_mg1"
            app:layout_constraintTop_toBottomOf="@id/view_side_bar_mg4"
            app:layout_constraintWidth_percent="0.8166"
            app:layout_constraintHeight_percent="0.0719"
            android:background="@drawable/btn_basic_unselected"
            android:backgroundTint="@null"
            android:text="주문내역 보기"
            android:textSize="25sp"
            android:textColor="@color/assu_font_sub"
            android:fontFamily="@font/pretendard_medium"/>

        <View
            android:id="@+id/view_side_bar_mg5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@+id/view_side_bar_mg1"
            app:layout_constraintTop_toBottomOf="@id/btn_side_bar_view_order_list"
            app:layout_constraintHeight_percent="0.0239"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_side_bar_order"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/view_side_bar_mg1"
            app:layout_constraintTop_toBottomOf="@id/view_side_bar_mg5"
            app:layout_constraintWidth_percent="0.8166"
            app:layout_constraintHeight_percent="0.0719"
            android:background="@drawable/btn_basic_selected"
            android:backgroundTint="@null"
            android:text="주문하기"
            android:textSize="25sp"
            android:textColor="@color/white"
            android:fontFamily="@font/pretendard_bold"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>